        <di:waypoint x="1820" y="455"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Imp_F_merge_dup" bpmnElement="Imp_F_merge_dup">
        <di:waypoint x="1715" y="482"/>
        <di:waypoint x="1795" y="482"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Imp_F_merge_bad" bpmnElement="Imp_F_merge_bad">
