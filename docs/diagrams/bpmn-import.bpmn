<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_import" targetNamespace="https://marktrace.example/educational-model" exporter="MarkTrace" exporterVersion="1.1">
  <bpmn:error id="Error_Technical" name="Техническая ошибка"/>
  <bpmn:process id="Process_import" name="Импорт данных CSV — UC7" isExecutable="false">
    <bpmn:documentation>Импорт данных CSV — UC7 (нумерация docs/09); версия 1.1, 16.11.2026, соответствует MVP (SPEC §2, backend/internal/importer). Сессия — любой непустой набор из items/codes/operations.csv; порядок items → codes → operations → сверка снимка; строки в порядке файла, каждая в своей транзакции. Описательная модель, isExecutable=false. Пояснения — docs/11-bpmn-process.md.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_import">
      <bpmn:lane id="Lane_import_user" name="Пользователь">
        <bpmn:flowNodeRef>Imp_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_import_system" name="MarkTrace">
        <bpmn:flowNodeRef>Imp_Structure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Row</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Fault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_RejectRow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_More</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Summary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_RejectAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_EndStructure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Imp_EndFailure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Imp_Start" name="Получена выгрузка">
      <bpmn:outgoing>Imp_F_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Imp_Select" name="Выбрать CSV (1–3 файла),&#10;A1 или A3">
      <bpmn:incoming>Imp_F_start</bpmn:incoming>
      <bpmn:outgoing>Imp_F_select</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Imp_Structure" name="Проверить права и заголовки&#10;выбранных файлов">
      <bpmn:incoming>Imp_F_select</bpmn:incoming>
      <bpmn:outgoing>Imp_F_structure</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Imp_Valid" name="Структура корректна?" default="Imp_F_structure_bad">
      <bpmn:incoming>Imp_F_structure</bpmn:incoming>
      <bpmn:outgoing>Imp_F_structure_ok</bpmn:outgoing>
      <bpmn:outgoing>Imp_F_structure_bad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Imp_Open" name="Создать сессию; строки в порядке&#10;items → codes → operations">
      <bpmn:incoming>Imp_F_structure_ok</bpmn:incoming>
      <bpmn:outgoing>Imp_F_open</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Imp_Queue" name="Есть записи?" default="Imp_F_empty">
      <bpmn:incoming>Imp_F_open</bpmn:incoming>
      <bpmn:outgoing>Imp_F_nonempty</bpmn:outgoing>
      <bpmn:outgoing>Imp_F_empty</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Imp_Row" name="Проверить и обработать&#10;строку (своя транзакция)">
      <bpmn:incoming>Imp_F_nonempty</bpmn:incoming>
      <bpmn:incoming>Imp_F_loop</bpmn:incoming>
      <bpmn:outgoing>Imp_F_row</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Imp_Fault" name="Технический сбой" attachedToRef="Imp_Row" cancelActivity="true">
      <bpmn:outgoing>Imp_F_technical</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Imp_Fault_error" errorRef="Error_Technical"/>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Imp_Result" name="Результат строки" default="Imp_F_row_bad">
      <bpmn:incoming>Imp_F_row</bpmn:incoming>
      <bpmn:outgoing>Imp_F_row_ok</bpmn:outgoing>
      <bpmn:outgoing>Imp_F_row_dup</bpmn:outgoing>
      <bpmn:outgoing>Imp_F_row_bad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Imp_Accept" name="Зафиксировать&#10;accepted">
      <bpmn:incoming>Imp_F_row_ok</bpmn:incoming>
      <bpmn:outgoing>Imp_F_merge_ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Imp_Duplicate" name="Зафиксировать&#10;duplicate, без новых данных">
      <bpmn:incoming>Imp_F_row_dup</bpmn:incoming>
      <bpmn:outgoing>Imp_F_merge_dup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Imp_RejectRow" name="Зафиксировать rejected&#10;и нарушение (одна причина)">
      <bpmn:incoming>Imp_F_row_bad</bpmn:incoming>
      <bpmn:outgoing>Imp_F_merge_bad</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Imp_Merge" name="">
      <bpmn:incoming>Imp_F_merge_ok</bpmn:incoming>
      <bpmn:incoming>Imp_F_merge_dup</bpmn:incoming>
      <bpmn:incoming>Imp_F_merge_bad</bpmn:incoming>
      <bpmn:outgoing>Imp_F_merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Imp_More" name="Остались записи?" default="Imp_F_done">
      <bpmn:incoming>Imp_F_merge</bpmn:incoming>
      <bpmn:outgoing>Imp_F_loop</bpmn:outgoing>
      <bpmn:outgoing>Imp_F_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Imp_Summary" name="Сверить снимок codes.csv;&#10;завершить сессию, счётчики">
      <bpmn:incoming>Imp_F_empty</bpmn:incoming>
      <bpmn:incoming>Imp_F_done</bpmn:incoming>
      <bpmn:outgoing>Imp_F_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Imp_End" name="Импорт завершён">
      <bpmn:incoming>Imp_F_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Imp_RejectAll" name="structure_rejected: строки&#10;не обрабатывать">
      <bpmn:incoming>Imp_F_structure_bad</bpmn:incoming>
      <bpmn:outgoing>Imp_F_structure_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Imp_EndStructure" name="Ошибка структуры">
      <bpmn:incoming>Imp_F_structure_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Imp_Failed" name="Остановить сессию с failed;&#10;принятые строки сохранены">
      <bpmn:incoming>Imp_F_technical</bpmn:incoming>
      <bpmn:outgoing>Imp_F_failure_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Imp_EndFailure" name="Техническая ошибка">
      <bpmn:incoming>Imp_F_failure_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Imp_F_start" sourceRef="Imp_Start" targetRef="Imp_Select" name=""/>
    <bpmn:sequenceFlow id="Imp_F_select" sourceRef="Imp_Select" targetRef="Imp_Structure" name=""/>
    <bpmn:sequenceFlow id="Imp_F_structure" sourceRef="Imp_Structure" targetRef="Imp_Valid" name=""/>
    <bpmn:sequenceFlow id="Imp_F_structure_ok" sourceRef="Imp_Valid" targetRef="Imp_Open" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">structure_valid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Imp_F_structure_bad" sourceRef="Imp_Valid" targetRef="Imp_RejectAll" name="Нет"/>
    <bpmn:sequenceFlow id="Imp_F_structure_end" sourceRef="Imp_RejectAll" targetRef="Imp_EndStructure" name=""/>
    <bpmn:sequenceFlow id="Imp_F_open" sourceRef="Imp_Open" targetRef="Imp_Queue" name=""/>
    <bpmn:sequenceFlow id="Imp_F_nonempty" sourceRef="Imp_Queue" targetRef="Imp_Row" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_rows = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Imp_F_empty" sourceRef="Imp_Queue" targetRef="Imp_Summary" name="Нет"/>
    <bpmn:sequenceFlow id="Imp_F_row" sourceRef="Imp_Row" targetRef="Imp_Result" name=""/>
    <bpmn:sequenceFlow id="Imp_F_row_ok" sourceRef="Imp_Result" targetRef="Imp_Accept" name="Принято">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">row_result = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Imp_F_row_dup" sourceRef="Imp_Result" targetRef="Imp_Duplicate" name="Дубль">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">row_result = 'duplicate'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Imp_F_row_bad" sourceRef="Imp_Result" targetRef="Imp_RejectRow" name="Отклонено"/>
    <bpmn:sequenceFlow id="Imp_F_merge_ok" sourceRef="Imp_Accept" targetRef="Imp_Merge" name=""/>
    <bpmn:sequenceFlow id="Imp_F_merge_dup" sourceRef="Imp_Duplicate" targetRef="Imp_Merge" name=""/>
    <bpmn:sequenceFlow id="Imp_F_merge_bad" sourceRef="Imp_RejectRow" targetRef="Imp_Merge" name=""/>
    <bpmn:sequenceFlow id="Imp_F_merge" sourceRef="Imp_Merge" targetRef="Imp_More" name=""/>
    <bpmn:sequenceFlow id="Imp_F_loop" sourceRef="Imp_More" targetRef="Imp_Row" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_more_rows = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Imp_F_done" sourceRef="Imp_More" targetRef="Imp_Summary" name="Нет"/>
    <bpmn:sequenceFlow id="Imp_F_end" sourceRef="Imp_Summary" targetRef="Imp_End" name=""/>
    <bpmn:sequenceFlow id="Imp_F_technical" sourceRef="Imp_Fault" targetRef="Imp_Failed" name=""/>
    <bpmn:sequenceFlow id="Imp_F_failure_end" sourceRef="Imp_Failed" targetRef="Imp_EndFailure" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_import">
    <bpmn:participant id="Participant_import" name="Импорт данных CSV — UC7" processRef="Process_import"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_import" name="Импорт данных CSV — UC7">
    <bpmndi:BPMNPlane id="Plane_import" bpmnElement="Collaboration_import">
      <bpmndi:BPMNShape id="Shape_Participant_import" bpmnElement="Participant_import" isHorizontal="true">
        <dc:Bounds x="20" y="160" width="2380" height="740"/>
      </bpmndi:BPMNShape>
