// ERD MarkTrace: physical schema as implemented in
// backend/internal/store/migrations/001_init.sql (PostgreSQL 16).
// Render: dot -Tpng -Gdpi=110 erd.dot -o erd.png && dot -Tsvg erd.dot -o erd.svg
// Notation: crow's foot. Solid line = FOREIGN KEY in the database;
// dashed line = logical reference kept by the application (no FK constraint).
// Parent key ports sit on the right cell of the row, child ports on the left cell.
digraph ERD {
  graph [rankdir=LR, fontname="Helvetica", fontsize=26, labelloc=t, labeljust=l, pad=0.4,
         nodesep=0.45, ranksep=1.1, splines=spline, newrank=true,
         label=<<B>ERD MarkTrace — физическая схема БД (001_init.sql)</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="17">Версия 2.0 · 16.11.2026 · PK — первичный ключ, FK — внешний ключ (ограничение в БД), UQ — уникальность, ref — логическая ссылка без FK, NULL — допускается пустое значение</FONT><BR ALIGN="LEFT"/>>];
  node  [shape=plaintext, fontname="Helvetica", fontsize=14];
  edge  [fontname="Helvetica", fontsize=13, color="#37474f", penwidth=1.6, dir=both];

  users [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#546e7a">
<TR><TD COLSPAN="3" BGCOLOR="#cfd8dc"><B>users</B> · учётные записи</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>username</B></TD><TD ALIGN="LEFT" PORT="username">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">text (bcrypt)</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">text CHECK A1..A4, admin</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text</TD></TR>
</TABLE>>];

  sessions [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#546e7a">
<TR><TD COLSPAN="3" BGCOLOR="#cfd8dc"><B>sessions</B> · сеансы входа</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>token</B></TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD ALIGN="LEFT" PORT="username">FK</TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">text, ON DELETE CASCADE</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
</TABLE>>];

  items [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565c0">
<TR><TD COLSPAN="3" BGCOLOR="#bbdefb"><B>items</B> · номенклатура</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>item_code</B></TD><TD ALIGN="LEFT" PORT="item_code">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">gtin</TD><TD ALIGN="LEFT">text (13/14 цифр)</TD></TR>
</TABLE>>];

  code_registry [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565c0">
<TR><TD COLSPAN="3" BGCOLOR="#bbdefb"><B>code_registry</B> · привязка и ожидаемый снимок</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>code</B></TD><TD ALIGN="LEFT" PORT="code">text</TD></TR>
<TR><TD ALIGN="LEFT" PORT="item_code">FK</TD><TD ALIGN="LEFT">item_code</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">expected_status</TD><TD ALIGN="LEFT">text NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">expected_ts</TD><TD ALIGN="LEFT">timestamptz NULL</TD></TR>
</TABLE>>];

  codes [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565c0">
<TR><TD COLSPAN="3" BGCOLOR="#bbdefb"><B>codes</B> · проекция текущего статуса</TD></TR>
<TR><TD ALIGN="LEFT" PORT="code"><B>PK, FK</B></TD><TD ALIGN="LEFT"><B>code</B></TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">item_code</TD><TD ALIGN="LEFT">text (копия привязки)</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text CHECK 5 статусов</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">ts</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">last_actor</TD><TD ALIGN="LEFT">text</TD></TR>
</TABLE>>];

  operations [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565c0">
<TR><TD COLSPAN="3" BGCOLOR="#bbdefb"><B>operations</B> · журнал принятых операций</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>op_id</B></TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD ALIGN="LEFT" PORT="code">FK, UQ1</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">op_type</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD ALIGN="LEFT">UQ1</TD><TD ALIGN="LEFT">ts</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">actor</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD ALIGN="LEFT" PORT="attempt_id">ref</TD><TD ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
</TABLE>>];

  import_sessions [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32">
<TR><TD COLSPAN="3" BGCOLOR="#c8e6c9"><B>import_sessions</B> · сеансы импорта</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>session_id</B></TD><TD ALIGN="LEFT" PORT="session_id">uuid</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">started_by</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">finished_at</TD><TD ALIGN="LEFT">timestamptz NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text CHECK 4 значения</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">failure_reason</TD><TD ALIGN="LEFT">text NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">files</TD><TD ALIGN="LEFT">jsonb</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">counters</TD><TD ALIGN="LEFT">jsonb NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">rows_created</TD><TD ALIGN="LEFT">integer NULL</TD></TR>
</TABLE>>];

  import_rows [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32">
<TR><TD COLSPAN="3" BGCOLOR="#c8e6c9"><B>import_rows</B> · строки CSV</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>row_id</B></TD><TD ALIGN="LEFT" PORT="row_id">uuid</TD></TR>
<TR><TD ALIGN="LEFT" PORT="session_id">FK</TD><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT">uuid</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">entity</TD><TD ALIGN="LEFT">text CHECK 3 значения</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">line_no</TD><TD ALIGN="LEFT">integer</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">key</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">raw</TD><TD ALIGN="LEFT">jsonb</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">processing_status</TD><TD ALIGN="LEFT">text CHECK 3 значения</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">text NULL</TD></TR>
</TABLE>>];

  operation_attempts [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#ef6c00">
<TR><TD COLSPAN="3" BGCOLOR="#ffe0b2"><B>operation_attempts</B> · попытки операций</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>attempt_id</B></TD><TD ALIGN="LEFT" PORT="attempt_id">uuid</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT">text CHECK form, import</TD></TR>
<TR><TD ALIGN="LEFT" PORT="import_row_id">FK</TD><TD ALIGN="LEFT">import_row_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">op_id</TD><TD ALIGN="LEFT">text (как введено)</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text (как введено)</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">op_type</TD><TD ALIGN="LEFT">text (как введено)</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">ts_raw</TD><TD ALIGN="LEFT">text (как введено)</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">actor</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">initiator</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">decision</TD><TD ALIGN="LEFT">text CHECK 3 значения</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">text NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">mock_result</TD><TD ALIGN="LEFT">jsonb NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">rules_version</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
</TABLE>>];

  violations [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#c62828">
<TR><TD COLSPAN="3" BGCOLOR="#ffcdd2"><B>violations</B> · нарушения</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>violation_id</B></TD><TD ALIGN="LEFT" PORT="violation_id">uuid</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT">text CHECK 3 значения</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">ref</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">item_code</TD><TD ALIGN="LEFT">text NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD ALIGN="LEFT" PORT="attempt_id">ref</TD><TD ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR>
<TR><TD ALIGN="LEFT" PORT="import_row_id">ref</TD><TD ALIGN="LEFT">import_row_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">rules_version</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">op_ts</TD><TD ALIGN="LEFT">timestamptz NULL</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">actor</TD><TD ALIGN="LEFT">text NULL</TD></TR>
</TABLE>>];

  violation_resolutions [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#c62828">
<TR><TD COLSPAN="3" BGCOLOR="#ffcdd2"><B>violation_resolutions</B> · разбор</TD></TR>
<TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">uuid</TD></TR>
<TR><TD ALIGN="LEFT" PORT="violation_id">FK, UQ2</TD><TD ALIGN="LEFT">violation_id</TD><TD ALIGN="LEFT">uuid</TD></TR>
<TR><TD ALIGN="LEFT">UQ2</TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">text CHECK comment, close</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">text CHECK не пусто</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">author</TD><TD ALIGN="LEFT">text</TD></TR>
<TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
<TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="12">UQ2: не более одного close на нарушение<BR ALIGN="LEFT"/>(частичный уникальный индекс)</FONT><BR ALIGN="LEFT"/></TD></TR>
</TABLE>>];

  legend [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#90a4ae">
<TR><TD COLSPAN="2" BGCOLOR="#eceff1"><B>Обозначения</B></TD></TR>
<TR><TD ALIGN="LEFT">сплошная</TD><TD ALIGN="LEFT">FOREIGN KEY в БД</TD></TR>
<TR><TD ALIGN="LEFT">пунктир</TD><TD ALIGN="LEFT">ref: логическая ссылка, проверяет приложение</TD></TR>
<TR><TD ALIGN="LEFT">||</TD><TD ALIGN="LEFT">ровно один</TD></TR>
<TR><TD ALIGN="LEFT">o|</TD><TD ALIGN="LEFT">ноль или один</TD></TR>
<TR><TD ALIGN="LEFT">o&lt;</TD><TD ALIGN="LEFT">ноль или много</TD></TR>
<TR><TD ALIGN="LEFT">UQ1</TD><TD ALIGN="LEFT">UNIQUE (code, ts)</TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT">Цвет: серый — доступ, синий — предметные<BR ALIGN="LEFT"/>данные, зелёный — импорт, оранжевый —<BR ALIGN="LEFT"/>попытки, красный — нарушения и разбор<BR ALIGN="LEFT"/></TD></TR>
</TABLE>>];

  { rank=same; users; items; import_sessions; }
  { rank=same; sessions; code_registry; import_rows; }
  { rank=same; codes; operation_attempts; }
  { rank=same; operations; violations; }
  { rank=same; violation_resolutions; legend; }

  // FK constraints (solid). Tail = parent (PK side), head = child (FK side).
  users:username:e -> sessions:username:w [arrowtail=teetee, arrowhead=crowodot, label="1 : 0..*"];
  items:item_code:e -> code_registry:item_code:w [arrowtail=teetee, arrowhead=crowodot, label="1 : 0..*"];
  code_registry:code:e -> codes:code:w [arrowtail=teetee, arrowhead=teeodot, label="1 : 0..1"];
  code_registry:code:e -> operations:code:w [arrowtail=teetee, arrowhead=crowodot, label="1 : 0..*"];
  import_sessions:session_id:e -> import_rows:session_id:w [arrowtail=teetee, arrowhead=crowodot, label="1 : 0..*"];
  import_rows:row_id:e -> operation_attempts:import_row_id:w [arrowtail=teeodot, arrowhead=crowodot, label="0..1 : 0..* (фактически 0..1)"];
  violations:violation_id:e -> violation_resolutions:violation_id:w [arrowtail=teetee, arrowhead=crowodot, label="1 : 0..*"];

  // Logical references without FK (dashed).
  operation_attempts:attempt_id:e -> operations:attempt_id:w [style=dashed, color="#78909c", arrowtail=teeodot, arrowhead=teeodot, label="0..1 : 0..1"];
  operation_attempts:attempt_id:e -> violations:attempt_id:w [style=dashed, color="#78909c", arrowtail=teeodot, arrowhead=teeodot, label="0..1 : 0..1"];
  import_rows:row_id:e -> violations:import_row_id:w [style=dashed, color="#78909c", arrowtail=teeodot, arrowhead=teeodot, label="0..1 : 0..1"];

  // Layout helpers.
  users -> items -> import_sessions [style=invis, dir=none];
  sessions -> code_registry -> import_rows [style=invis, dir=none];
  codes -> operation_attempts [style=invis, dir=none];
  operations -> violations [style=invis, dir=none];
  violation_resolutions -> legend [style=invis, dir=none];
}
