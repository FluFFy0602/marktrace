      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_operation_system" bpmnElement="Lane_operation_system" isHorizontal="true">
        <dc:Bounds x="50" y="300" width="2080" height="600"/>
