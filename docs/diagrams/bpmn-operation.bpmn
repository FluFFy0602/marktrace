        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Op_F_commit" bpmnElement="Op_F_commit">
        <di:waypoint x="1480" y="430"/>
        <di:waypoint x="1535" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Op_F_applied" bpmnElement="Op_F_applied">
        <di:waypoint x="1585" y="430"/>
        <di:waypoint x="1690" y="430"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1615" y="408" width="40" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Op_F_conflict" bpmnElement="Op_F_conflict">
        <di:waypoint x="1560" y="455"/>
        <di:waypoint x="1560" y="585"/>
        <di:waypoint x="1615" y="585"/>
        <di:waypoint x="1615" y="635"/>
