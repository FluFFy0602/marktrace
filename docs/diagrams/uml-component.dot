// UML Component diagram of MarkTrace MVP (docs/27-architecture.md).
// Render: dot -Tpng -Gdpi=110 uml-component.dot -o uml-component.png && dot -Tsvg uml-component.dot -o uml-component.svg
digraph UMLComponent {
  graph [rankdir=TB, fontname="Helvetica", fontsize=16, nodesep=0.45, ranksep=0.55, pad=0.3, newrank=true,
         label="MarkTrace MVP — UML Component\n", labelloc=t];
  node  [fontname="Helvetica", fontsize=13, shape=component, style=filled, fillcolor="#e8f0fb", color="#1f4e8c", penwidth=1.3];
  edge  [fontname="Helvetica", fontsize=11, color="#333333"];

  user [shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor=white, color="#08427b",
        label="Пользователь: A1, A2, A3, A4, admin\n(браузер)"];

  subgraph cluster_web {
    label="«container» web — nginx 1.27 + React 18 SPA, порт 8080"; style="rounded"; color="#1f4e8c"; fontsize=14;
    i_ui  [shape=ellipse, style=filled, fillcolor=white, label="«interface»\nHTTP :8080 (HTML/JS)"];
    spa   [label="«component»\nSPA (web/src)\nОперация, Коды, Код, Расхождения,\nИмпорт, Сводка KPI, Проверка кода"];
    proxy [label="«component»\nnginx reverse proxy\nlocation /api/ → backend:8080"];
  }

  subgraph cluster_backend {
    label="«container» backend — Go, net/http, pgx v5; порт 8081 → 8080"; style="rounded"; color="#1f4e8c"; fontsize=14;
    i_rest   [shape=ellipse, style=filled, fillcolor=white, label="«interface»\nREST /api (JSON, CSV, cookie mt_session)"];
    mainc    [label="«component»\ncmd/server\nenv, запуск, graceful shutdown"];
    httpapi  [label="«component»\nhttpapi\nмаршруты, проверка ролей,\nформат ошибок"];
    authc    [label="«component»\nauth\nвход, сессии"];
    importer [label="«component»\nimporter\nсессии импорта CSV,\nпроверка снимка"];
    reports  [label="«component»\nreports\nотчёты, расхождения,\nKPI, сверка с golden"];
    opsc     [label="«component»\nops\nдвижок операций,\nформа, MockClient"];
    rulesc   [label="«component»\nrules (Shared Kernel)\nGTIN, маска, время,\nпереходы, коды причин", fillcolor="#fff4d6", color="#a07000"];
    storec   [label="«component»\nstore\nпул pgxpool (общий для auth, ops,\nimporter, reports), миграции, seed"];
  }

  subgraph cluster_mock {
    label="«container» mock — Go stdlib, порт 8082 → 8080"; labelloc=b; style="rounded"; color="#666666"; fontsize=14;
    i_cz     [shape=ellipse, style=filled, fillcolor=white, color="#555555", label="«interface»\nPOST /cz/verify"];
    mocksrv  [label="«component»\nmock server (имитация ЦРПТ)\n/cz/verify, /admin/mode, /healthz", fillcolor="#eeeeee", color="#555555"];
    registry [shape=note, fillcolor="#fafafa", color="#777777", label="«artifact»\nmock_registry.csv\n(том /data, ro)"];
  }

  subgraph cluster_db {
    label="«container» db — PostgreSQL 16"; labelloc=b; style="rounded"; color="#2e7d32"; fontsize=14;
    i_sql [shape=ellipse, style=filled, fillcolor=white, color="#2e7d32", label="«interface»\nSQL :5432"];
    pg    [shape=cylinder, fillcolor="#e6f4e6", color="#2e7d32", label="схема 001_init.sql\n11 таблиц, том pgdata"];
  }

  golden [shape=note, fillcolor="#fafafa", color="#777777", label="«artifact»\ngolden/*.csv\n(том /golden, ro)"];

  // Realisations of provided interfaces (solid, no arrow head).
  edge [arrowhead=none, penwidth=1.3];
  i_ui -> spa;
  i_rest -> httpapi;
  i_cz -> mocksrv;
  i_sql -> pg;

  // Usage of interfaces and between containers (dashed «use»).
  edge [style=dashed, arrowhead=vee, penwidth=1.1];
  user -> i_ui [label=" «use»"];
  spa -> proxy [label=" fetch /api/*"];
  proxy -> i_rest [label=" «use» proxy_pass"];
  opsc -> i_cz [xlabel="«use», таймаут 2 с"];
  storec -> i_sql [xlabel="«use»"];
  mocksrv -> registry [label=" читает\n при старте"];
  reports -> golden [label=" GOLDEN_DIR"];

  // Go package dependencies inside backend.
  edge [color="#1f4e8c", fontcolor="#1f4e8c"];
  mainc -> httpapi [label=" New()"];
  mainc -> storec [label=" Init()"];
  httpapi -> authc;
  httpapi -> importer;
  httpapi -> reports;
  httpapi -> opsc [label=" Submit(),\n Verify()"];
  importer -> opsc [label=" ProcessImportRow()"];
  reports -> opsc [label=" CodeRow"];
  opsc -> storec [label=" store.DB"];
  edge [color="#a07000", fontcolor="#a07000"];
  opsc -> rulesc;
  importer -> rulesc;
  reports -> rulesc;
  httpapi -> rulesc;

  { rank=same; i_rest; mainc; }
  { rank=same; authc; importer; reports; }
  { rank=same; opsc; }
  { rank=same; rulesc; storec; }
}
